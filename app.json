{
  "expo": {
    "name": "TILA",
    "slug": "tila-app",
    "version": "1.0.0",
    "scheme": "mindwellconnect",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.tila.app",
      "appleTeamId": "VOTRE_TEAM_ID"
    },
    "android": {
      "package": "ci.tila.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tila to access your camera for video consultations.",
          "microphonePermission": "Allow Tila to access your microphone for video consultations."
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "https://apiv2.tila.ci"
    }
  }
}
